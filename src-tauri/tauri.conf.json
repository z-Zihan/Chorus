{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Chorus",
  "version": "0.1.0",
  "identifier": "com.chorus.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build && pnpm tauri:prepare-sidecar",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../packages/web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Chorus",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "showMenuOnLeftClick": false,
      "tooltip": "Chorus"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "resources": {
      "../packages/server/dist/": "packages/server/dist/",
      "../packages/server/package.json": "packages/server/dist/package.json",
      "runtime/node_modules/": "packages/server/dist/node_modules/",
      "../skills/": "skills/"
    },
    "externalBin": ["binaries/chorus-node"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": false,
      "endpoints": ["https://releases.chorus.app/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": ""
    }
  }
}
