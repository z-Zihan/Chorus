# Browser API base URL. Relative URLs use the current origin.
VITE_API_BASE_URL=/api

# Browser WebSocket endpoint.
VITE_WS_BASE_URL=ws://localhost:3210/ws

# Initial UI theme: dark, light, or system.
VITE_DEFAULT_THEME=dark

# Initial UI language: zh-CN or en.
VITE_DEFAULT_LANG=zh-CN

# Optional signed desktop update endpoint. Leave empty to disable update checks.
VITE_CHORUS_UPDATE_ENDPOINT=

# HTTP/WebSocket server port.
SERVER_PORT=3210

SERVER_HOST=127.0.0.1

# Server logging level: trace, debug, info, warn, error, or fatal.
SERVER_LOG_LEVEL=info

SERVER_LOG_FILE=./data/logs/server.log
SERVER_LOG_MAX_BYTES=5242880
SERVER_LOG_MAX_FILES=5

# SQLite database path, absolute or relative to chorus.config.ts.
SERVER_DB_PATH=./data/chorus.db

# Encrypted credential-file fallback when the system keychain is unavailable.
CHORUS_CREDENTIAL_FILE=

# Relay runtime
RELAY_HOST=127.0.0.1
RELAY_PORT=3211
RELAY_JWT_SECRET=
RELAY_TOKEN_TTL_SECONDS=86400
RELAY_OFFLINE_TTL_DAYS=7
RELAY_OFFLINE_RETENTION_MS=
RELAY_DB_PATH=./data/relay.db
RELAY_LOG_LEVEL=info
RELAY_LOG_FILE=./data/logs/relay.log
RELAY_LOG_MAX_BYTES=5242880
RELAY_LOG_MAX_FILES=5
RELAY_CORS_ORIGINS=
RELAY_MAX_HUBS=1000
RELAY_MAX_MESSAGE_SIZE=262144
RELAY_MAX_MESSAGES_PER_HUB=1000
RELAY_MAX_MESSAGES_PER_MINUTE=60
RELAY_MAX_ROOMS_PER_HUB=50
RELAY_MAX_MEMBERS_PER_ROOM=100
RELAY_MAX_CHALLENGES_PER_MINUTE=10
RELAY_MAX_REGISTRATIONS_PER_MINUTE=30

# Only required when the OpenAI adapter is enabled.
OPENAI_API_KEY=
