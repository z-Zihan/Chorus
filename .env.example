# Browser API base URL. Relative URLs use the current origin.
VITE_API_BASE_URL=/api

# Browser WebSocket endpoint.
VITE_WS_BASE_URL=ws://localhost:3210/ws

# Initial UI theme: dark, light, or system.
VITE_DEFAULT_THEME=dark

# Initial UI language: zh-CN or en.
VITE_DEFAULT_LANG=zh-CN

# HTTP/WebSocket server port.
SERVER_PORT=3210

# Server logging level: trace, debug, info, warn, error, or fatal.
SERVER_LOG_LEVEL=info

# SQLite database path, absolute or relative to chorus.config.ts.
SERVER_DB_PATH=./data/chorus.db

# Only required when the OpenAI adapter is enabled.
OPENAI_API_KEY=
