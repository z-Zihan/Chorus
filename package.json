{
  "name": "agentlink",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"pnpm --filter @agentlink/server dev\" \"pnpm --filter @agentlink/web dev\"",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "db:generate": "pnpm --filter @agentlink/server db:generate",
    "db:migrate": "pnpm --filter @agentlink/server db:migrate",
    "db:studio": "pnpm --filter @agentlink/server db:studio",
    "build": "pnpm --filter @agentlink/shared build && pnpm --filter @agentlink/server build && pnpm --filter @agentlink/web build",
    "test": "pnpm --filter @agentlink/shared test && pnpm --filter @agentlink/server test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "start": "pnpm --filter @agentlink/server start"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.0.0",
    "concurrently": "^9.2.0",
    "eslint": "9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0"
  }
}
